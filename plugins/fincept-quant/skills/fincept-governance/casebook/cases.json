{
  "version": "1.0.0",
  "note": "Real records from the user's Liquid paper account (Co-Invest connector, get_position_history and execute_order results) plus stress scenarios. Times are UTC; report them in America/Mexico_City (UTC-6). Agents answer each case with one JSON object: {\"case_id\", \"decision\", \"figures\": {...}, \"explanation\"}. The grader is scripts/fincept-grade.js.",
  "cases": [
    {
      "id": "C1-gold-short-open",
      "phase": 1,
      "agents": [
        "fincept-data-analyst",
        "fincept-compliance-officer"
      ],
      "task": "Value the open paper position at the given mark and say which policy rules it breaks today.",
      "input": {
        "mode": "paper",
        "symbol": "xyz:GOLD-PERP",
        "side": "short",
        "size": 0.0238,
        "entry_price": 4205.6,
        "opened_at": "2026-10-12T02:57:38Z",
        "order_id": "115223",
        "mark_price": 4103.6,
        "tp": null,
        "sl": null,
        "planned_hold_minutes": 10,
        "notes": "The user approved a close at 10 minutes, then rejected the close tool call; the position stayed open."
      },
      "expected": {
        "decision": "ESCALAR",
        "figures": {
          "notional_entry_usd": {
            "value": 100.09,
            "tol": 0.02
          },
          "unrealized_pnl_usd": {
            "value": 2.4276,
            "tol": 0.005
          }
        },
        "must_include_any": [
          [
            "sin stop",
            "sin sl",
            "no tiene stop",
            "sin protección",
            "without stop"
          ],
          [
            "usuario",
            "dueño",
            "owner"
          ]
        ],
        "must_not_include": [
          "ya cerré la posición",
          "lo cierro ahora",
          "ejecuté el cierre"
        ]
      }
    },
